PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional password — if set, the UI prompts once and stores it in localStorage.
# Leave empty (or unset) to disable auth entirely.
DASHBOARD_PASSWORD=
DASHBOARD_TITLE=Family Dashboard

# Immich
IMMICH_BASE_URL=https://your-immich.example.com
IMMICH_API_KEY=replace-me
# Comma-separated person UUIDs (the dashboard ORs across these)
IMMICH_PERSON_IDS=uuid1,uuid2,uuid3
IMMICH_PHOTO_INTERVAL_SECONDS=300

# Weather (Open-Meteo, no API key)
WEATHER_LATITUDE=60.17
WEATHER_LONGITUDE=24.94
WEATHER_TIMEZONE=Europe/Helsinki
# Number of upcoming hourly forecasts to show in the weather card (default 5)
WEATHER_HOURLY_COUNT=5

# Home Assistant
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=replace-me

# Calendar (sourced from HA's Google Calendar integration)
CALENDAR_ENTITIES=calendar.family,calendar.hobbies
CALENDAR_DAYS_AHEAD=5

# Sensors (up to 20, sequential — stop at first gap)
# ENTITY:     Home Assistant entity_id (required)
# LABEL:      display name
# UNIT:       display unit (ignored for text sensors)
# DECIMALS:   decimal places after rounding (default 0)
# MULTIPLIER: multiply raw value before rounding (default 1, use e.g. 0.001 to convert W→kW)
# SHOW_ABOVE: only show this sensor when its raw value exceeds this threshold
# TEXT:       set to "true" for sensors with string states (e.g. Idle/Charging); shows a
#             history timeline bar instead of a sparkline in expanded view
SENSOR_1_ENTITY=sensor.ulkolampotila
SENSOR_1_LABEL=Lämpötila
SENSOR_1_UNIT=°C

SENSOR_2_ENTITY=sensor.palju_vesi
SENSOR_2_LABEL=Palju
SENSOR_2_UNIT=°C
SENSOR_2_SHOW_ABOVE=25

SENSOR_3_ENTITY=sensor.sauna_lampotila
SENSOR_3_LABEL=Sauna
SENSOR_3_UNIT=°C
SENSOR_3_SHOW_ABOVE=40

SENSOR_4_ENTITY=sensor.inverter_pv_power
SENSOR_4_LABEL=Tuotantoteho
SENSOR_4_UNIT=kW
SENSOR_4_MULTIPLIER=0.001
SENSOR_4_DECIMALS=1

SENSOR_5_ENTITY=sensor.inverter_today_production
SENSOR_5_LABEL=Tuotanto tänään
SENSOR_5_UNIT=kWh
SENSOR_5_DECIMALS=1

SENSOR_6_ENTITY=sensor.carcharger_carstatus_state
SENSOR_6_LABEL=Auton lataus
SENSOR_6_TEXT=true

# Electricity color thresholds (c/kWh, with VAT)
# < ELEC_GREEN_BELOW → green; > ELEC_RED_ABOVE → red; in between → yellow
ELEC_GREEN_BELOW=10
ELEC_RED_ABOVE=20

# Cameras (optional — leave unset to hide the camera button)
# Comma-separated Home Assistant camera entity IDs (Frigate or any HA camera).
# Snapshots are proxied through HA's camera_proxy endpoint using HA_TOKEN.
# Click the camera button to open a 2×2 live view; click a tile to go fullscreen.
CAMERA_ENTITIES=camera.autokatos,camera.etuovi,camera.ovikello,camera.takaterassi

# Controls (optional — up to 20, leave unset to hide the controls button)
# On/off toggles for switch.* / input_boolean.* / light.* entities, plus climate.*, shown in an
# overlay behind the toggle button. Only entities listed here can be switched.
CONTROL_1_ENTITY=input_boolean.force_heating_on
CONTROL_1_LABEL=Lämmitys päälle
CONTROL_2_ENTITY=input_boolean.force_boiler_on
CONTROL_2_LABEL=Lämminvesi päälle
CONTROL_3_ENTITY=switch.valheim_serveri
CONTROL_3_LABEL=Valheim-serveri
# Optional status sensor: shown on the tile (starting/running/deallocating/...),
# and the tile stays locked while the state is changing.
CONTROL_3_STATUS_ENTITY=sensor.valheim_vm_tila
CONTROL_4_ENTITY=input_boolean.security_armed
CONTROL_4_LABEL=Hälytys
CONTROL_5_ENTITY=light.pihavalot
CONTROL_5_LABEL=Pihavalot
# climate.* entities get a wider tile with target temperature −/+ and mode buttons
CONTROL_6_ENTITY=climate.melcloudhome_d078_7886_climate
CONTROL_6_LABEL=Alakerta
CONTROL_7_ENTITY=climate.melcloudhome_64f0_18ba_climate
CONTROL_7_LABEL=Yläkerta

# Music (optional — leave MUSIC_PLAYER unset to disable)
# A Music Assistant player entity in HA. While it is playing or paused, a
# now-playing card appears at the top of the dashboard. Favourites starred in
# the Music Assistant app (playlists, radio, albums, artists) appear as one-tap
# presets in the controls overlay.
MUSIC_PLAYER=media_player.kitchen_speaker_2
MUSIC_PRESET_LIMIT=8

# Voice assistant (optional — leave VOICE_STT unset to hide the mic button)
# Tap-to-talk through HA's speech-to-text, a conversation agent and TTS.
# The microphone only works when the dashboard is served over HTTPS.
VOICE_STT=stt.home_assistant_cloud
VOICE_TTS=tts.home_assistant_cloud
# Conversation agent. With VOICE_PREFER_LOCAL (default true), HA's built-in
# agent is tried first (fast, fixed Finnish sentence patterns) and this agent
# only answers what the built-in one doesn't understand.
VOICE_AGENT=conversation.gpt_5_4_mini
VOICE_PREFER_LOCAL=true
VOICE_LANGUAGE=fi-FI
